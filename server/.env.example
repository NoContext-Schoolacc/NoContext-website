NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT=
LICENSE_HMAC_SECRET=generate-a-long-random-secret-at-least-32-chars
WORKINK_LINK_IDS={"external":12345}
PUBLIC_ORIGIN=https://your-domain.example
TRUST_PROXY=false

# Keep real values out of GitHub. Set them in your hosting provider's secret/environment settings.
# WORKINK_LINK_IDS maps each product to the exact Work.ink link ID allowed to issue a license.
# Set TRUST_PROXY=true only when your hosting provider is a trusted reverse proxy.
