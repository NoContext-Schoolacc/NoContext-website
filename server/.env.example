NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT=
LICENSE_HMAC_SECRET=generate-a-long-random-secret-at-least-32-chars
ADMIN_API_KEY=generate-a-separate-long-random-admin-key-at-least-32-chars
WORKINK_LINK_IDS={"external":12345}
PUBLIC_ORIGIN=https://your-domain.example
TRUST_PROXY_HOPS=0

# Keep real values out of GitHub. Set them in your hosting provider's secret/environment settings.
# WORKINK_LINK_IDS maps each product to the exact Work.ink link ID allowed by the backend.
# PUBLIC_ORIGIN is required in production and must be the exact website origin, e.g. https://example.com.
# TRUST_PROXY_HOPS is the exact number of trusted reverse proxies in front of the backend. Use 0 unless you know this value.
# ADMIN_API_KEY protects the /api/admin/* endpoints. Never expose it in source control.
